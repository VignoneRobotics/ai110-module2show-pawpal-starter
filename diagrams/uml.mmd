classDiagram
    %% PawPal+ UML (final). Matches pawpal_system.py.

    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet) None
        +get_pet(name) Pet
        +get_all_tasks() list~Task~
        +find_task(task_id) tuple
        +save_to_json(path) None
        +load_from_json(path)$ Owner
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task_id) None
        +get_tasks() list~Task~
    }

    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +date due_date
        +str task_id
        +bool completed
        +str pet_name
        +mark_complete() None
        +next_occurrence(today) Task
    }

    class Scheduler {
        +Owner owner
        +sort_by_time(tasks) list~Task~
        +sort_by_priority(tasks) list~Task~
        +filter_tasks(tasks, pet_name, completed) list~Task~
        +find_conflict_pairs(tasks) list~tuple~
        +detect_conflicts(tasks) list~str~
        +next_available_slot(duration_minutes, day, window_start, window_end) str
        +mark_task_complete(task_id, today) Task
        +build_daily_plan(day) tuple
        +explain_plan(planned, skipped) list~str~
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" *-- "*" Task : has
    Scheduler --> Owner : reads tasks via get_all_tasks()
